@model IReadOnlyList<ProjectDto>
@{
    ViewData["Title"] = "Projects — Admin";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 fw-bold mb-0">Projects</h1>
        <a class="btn btn-primary" asp-area="Admin" asp-controller="Admin" asp-action="CreateProject">New Project</a>
    </div>

    @if (TempData["SuccessMessage"] is not null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] is not null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    @if (Model.Count == 0)
    {
        <p class="text-body-secondary">No projects yet. Create the first one.</p>
    }

    <div class="list-group shadow-sm">
        @foreach (var project in Model)
        {
            <div class="list-group-item bg-transparent py-3">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                    <div>
                        <span class="fw-semibold me-2">@project.Title</span>
                        <span class="badge text-bg-secondary">@project.Category</span>
                        @if (project.IsFeatured)
                        {
                            <span class="badge text-bg-primary">Featured</span>
                        }
                        <div class="text-body-secondary small mt-1">
                            Order @project.DisplayOrder — @project.TechStack.Count technologies, @project.TechnicalHighlights.Count highlights
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <a class="btn btn-sm btn-outline-primary" asp-area="Admin" asp-controller="Admin" asp-action="EditProject" asp-route-id="@project.Id">Edit</a>
                        <form asp-area="Admin" asp-controller="Admin" asp-action="DeleteProject" asp-route-id="@project.Id" method="post"
                              onsubmit="return confirm('Delete project \'@project.Title\'? This cannot be undone.');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
